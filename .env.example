# Copy to .env.local for local overrides. Never commit real credentials.
PORT=3001
# Use an absolute path on a persistent disk when deploying:
# ANALYTICS_DB_PATH=/persistent-data/analytics.sqlite
# Optional key file on a private persistent disk:
# ANALYTICS_ADMIN_KEY_FILE=/persistent-data/analytics.key
# Or provide a private server-only ANALYTICS_ADMIN_KEY of at least 24 characters
# through the hosting platform's secret environment settings.
# Never prefix the key with VITE_ (which exposes values to the browser bundle).

# Local Node room storage (Cloudflare uses the ROOMS Durable Object binding):
# ROOMS_DB_PATH=/persistent-data/rooms.sqlite
