{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geneki-draft-room",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DraftRoom" }],
  },
  "migrations": [{ "tag": "v1-rooms", "new_sqlite_classes": ["DraftRoom"] }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geneki-draft-analytics",
      "database_id": "59b49957-9950-489a-a098-6ce9448b01af",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "triggers": { "crons": ["10 15 * * *"] },
}
